<a title="{{ library.name }}"
   href="{{ library.info }}"
   class="group animate-fade  border rounded-lg shadow p-5 space-y-3 transition-colors hover:border-sky-400 hover:shadow-sky-400">
    <div class="is-size-4 flex justify-between">
        <h2 class="text-2xl font-medium transition-colors m-0 text-slate-600 group-hover:text-slate-900 ">
            <span class="mx-2 text-slate-500 group-hover:text-sky-700">/</span>
            {{ library.name }}
        </h2>
        <span class="opacity-0 group-hover:opacity-100 inline-flex items-center justify-center rounded-md text-sm font-medium bg-secondary text-secondary-foreground h-10 px-4 py-2">
            read more
        </span>
    </div>
    <p class="font-light text-slate-600 text-lg border-b pb-3">{{ library.short_description }}</p>
    <div class="flex max-md:flex-col gap-4 md:gap-6">
        <div class="md:w-1/3 space-y-4">
            <figure>
                {% image "./src/static/img/atlas-home.png", "atlas home page", "(min-width:768px) 340px, 92vw", "asdf", "eager", "async", "", "high" %}
            </figure>
            <figure>
                {% image "./src/static/img/report_group.png", "atlas information sources", "(min-width:768px) 340px, 92vw", "asdf", "lazy", "async" %}
            </figure>
        </div>
        <div class="md:w-2/3 space-y-4 text-slate-700">
            <p>{{ library.description }}</p>
            <p class="">{{ library.long_description | markdown | safe }}</p>
        </div>
    </div>
</a>
