# Public site origin (apex, no www). Canonical URLs, sitemap, installer links.
# Requests to www.* are 301-redirected to this host at the origin.
SITE_URL=http://127.0.0.1:8080
SITE_EMAIL_DAN=
SITE_EMAIL_CHRISTOPHER=

# Meilisearch — prefer Coolify internal HTTP (same Docker network), not public HTTPS.
# Example: http://<meili-uuid>:7700 or http://meilisearch:7700
MEILI_HOST=http://127.0.0.1:7700
MEILI_PORT=7700
MEILI_INDEX=atlas

# Server-side keys only (never shipped to the browser).
MEILI_MASTER_KEY=atlas-dev-master-key
MEILI_SEARCH_KEY=atlas-dev-master-key

# GlitchTip — browser uses the DSN host only as metadata; traffic goes to same-origin tunnel.
GLITCHTIP_DSN=https://example.com/5
GLITCHTIP_TUNNEL=/glitchtip
GLITCHTIP_SECURITY_ENDPOINT=/glitchtip/security
GLITCHTIP_TRACES_SAMPLE_RATE=0.01
GLITCHTIP_ENVIRONMENT=development
GLITCHTIP_RELEASE=

# Umami — prefer Coolify internal HTTP, e.g. http://<analytics-uuid>:3000
# Public https://analytics.atlas.bi often fails from the website container (self-signed TLS).
ANALYTICS_HOST=http://127.0.0.1:3000
ANALYTICS_WEBSITE_ID=1
# Only if you must use HTTPS with a self-signed Coolify cert:
# UPSTREAM_TLS_INSECURE=true

# Production origin (`pnpm serve`). Cloudflare Tunnel → this port.
PORT=80
# SITE_STATIC_DIR=_site

